{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "./",
    "resolveJsonModule": true,
    "typeRoots": ["./node_modules/@types"],
    "types": [
      "node",
      "@wdio/globals/types",
      "@wdio/cucumber-framework",
      "chai"
    ],
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"],
      "@web/*": ["./web/*"],
      "@mobile/*": ["./mobile/*"],
      "@backend/*": ["./backend/*"],
      "@utils/*": ["./utils/*"],
      "@features/*": ["./features/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.js",
    "features/**/*.feature"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "allure-results",
    "allure-report"
  ],
  "ts-node": {
    "compilerOptions": {
      "module": "CommonJS"
    }
  }
}
